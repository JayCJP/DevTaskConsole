{
  "name": "devtask-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @devtask/server --filter @devtask/web dev",
    "dev:server": "pnpm --filter @devtask/server dev",
    "dev:web": "pnpm --filter @devtask/web dev",
    "build": "pnpm --recursive --if-present build",
    "start": "pnpm --filter @devtask/server start",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,mjs,cjs,json,md,css,html}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  }
}
