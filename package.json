{
  "name": "devtask-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @devtask/server --filter @devtask/web dev",
    "dev:server": "pnpm --filter @devtask/server dev",
    "dev:web": "pnpm --filter @devtask/web dev",
    "build": "pnpm --recursive --if-present build",
    "start": "pnpm --filter @devtask/server start",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "lint": "eslint \"apps/**/src/**/*.{ts,vue}\" \"packages/**/src/**/*.{ts,vue}\"",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,css,html}": "prettier --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
